# 统一换行符，避免 Windows 下 CRLF/LF 混用导致的 diff 噪音
* text=auto eol=lf

# 明确文本类型
*.md    text eol=lf
*.py    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
LICENSE      text eol=lf
LICENSE-DOCS text eol=lf

# 二进制
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
