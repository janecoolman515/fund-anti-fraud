.page {
  min-height: 100vh;
  background: #0E2A4A;
  padding-bottom: 60rpx;
}

/* ── 品牌标题 ── */
.brand {
  padding: 32rpx 32rpx 6rpx;
}

.brand-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #E8C55C;
  line-height: 1.35;
  letter-spacing: 0.5rpx;
}

.brand-sub {
  font-size: 22rpx;
  color: #94AECB;
  margin-top: 10rpx;
}

/* ── HERO ── */
.hero {
  padding: 44rpx 32rpx 36rpx;
  background: linear-gradient(180deg, #204B7C 0%, #0E2A4A 100%);
  border-bottom: 1rpx solid #33628F;
}

.eyebrow {
  display: inline-block;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #C9A227;
  border: 1rpx solid rgba(201, 162, 39, 0.3);
  background: rgba(201, 162, 39, 0.1);
  padding: 6rpx 18rpx;
  border-radius: 100rpx;
  margin-bottom: 22rpx;
}

.h1 {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.35;
  color: #E8F0F8;
  letter-spacing: -0.5rpx;
}

.h1.gold {
  color: #E8C55C;
  margin-bottom: 26rpx;
}

/* 搜索框 */
.search {
  display: flex;
  align-items: center;
  background: #204B7C;
  border: 1rpx solid #3A74AA;
  border-radius: 14rpx;
  padding: 8rpx;
  margin-bottom: 22rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  color: #E8F0F8;
  padding: 0 20rpx;
}

.ph {
  color: #7189A6;
}

.search-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 40rpx;
  background: linear-gradient(180deg, #E8C55C, #C9A227);
  color: #1A1400;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 10rpx;
  flex: none;
}

/* 顶部与结尾共用 .home-contact 金色卡片，无独立样式 */

/* 热门 */
.hot {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.hot-label {
  font-size: 22rpx;
  color: #7189A6;
  margin-right: 14rpx;
}

.chip {
  font-size: 22rpx;
  color: #BED2E6;
  background: #204B7C;
  border: 1rpx solid #33628F;
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
  margin-right: 12rpx;
  margin-bottom: 10rpx;
}

/* ── 卡片 ── */
.card {
  margin: 20rpx 24rpx;
  padding: 28rpx;
  background: #1A4270;
  border: 1rpx solid #33628F;
  border-radius: 16rpx;
}

.sec-label {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #7189A6;
  margin-bottom: 8rpx;
}

.sec-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #E8F0F8;
  margin-bottom: 10rpx;
}

.sec-desc {
  font-size: 22rpx;
  color: #94AECB;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.hr {
  height: 1rpx;
  background: #33628F;
  margin: 24rpx 0;
}

/* ── 报告头 ── */
.report-head {
  background: linear-gradient(180deg, #245488 0%, #1A4270 100%);
  border-color: #3A74AA;
}

.rh-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.rh-name {
  font-size: 38rpx;
  font-weight: 800;
  color: #E8F0F8;
  flex: 1;
}

.rh-tag {
  font-size: 18rpx;
  color: #94AECB;
  border: 1rpx solid #3A74AA;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  margin-left: 10rpx;
  font-weight: 400;
  vertical-align: middle;
}

.rh-score {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}

.rh-meta {
  font-size: 22rpx;
  color: #94AECB;
  line-height: 1.8;
}

.lv-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.lv-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.lv-text {
  font-size: 30rpx;
  font-weight: 700;
}

.lv-note {
  font-size: 22rpx;
  color: #7189A6;
  line-height: 1.6;
}

/* ── 四维 ── */
.dim {
  margin-bottom: 24rpx;
}

.dim:last-child {
  margin-bottom: 0;
}

.dim-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.dim-name {
  font-size: 25rpx;
  color: #BED2E6;
  font-weight: 600;
}

.dim-val {
  font-size: 24rpx;
  color: #E8F0F8;
}

.dim-bar {
  height: 6rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 3rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.dim-fill {
  height: 100%;
  border-radius: 3rpx;
}

.dim-tags {
  font-size: 20rpx;
  color: #7189A6;
  line-height: 1.5;
}

/* ── 证据 ── */
.ev {
  padding: 22rpx 0;
  border-top: 1rpx solid #245488;
}

.ev:first-of-type {
  border-top: none;
}

.ev-h {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.ev-n {
  font-size: 20rpx;
  color: #7189A6;
  margin-right: 12rpx;
}

.ev-i {
  font-size: 24rpx;
  color: #BED2E6;
  font-weight: 600;
}

.ev-f {
  font-size: 25rpx;
  color: #E8F0F8;
  line-height: 1.65;
  margin-bottom: 8rpx;
}

.ev-w {
  font-size: 23rpx;
  color: #94AECB;
  line-height: 1.6;
  margin-bottom: 6rpx;
}

.ev-s {
  font-size: 20rpx;
  color: #7189A6;
}

/* ── 结局链 ── */
.chain {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.chain-step {
  font-size: 20rpx;
  color: #94AECB;
  background: #204B7C;
  border: 1rpx solid #33628F;
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

.chain-step.on {
  color: #F09A97;
  background: rgba(217, 67, 63, 0.12);
  border-color: rgba(217, 67, 63, 0.4);
}

/* ── 建议 ── */
.adv {
  margin-bottom: 20rpx;
}

.adv:last-child {
  margin-bottom: 0;
}

.adv-b {
  font-size: 24rpx;
  color: #E8C55C;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.adv-t {
  font-size: 24rpx;
  color: #BED2E6;
  line-height: 1.65;
}

/* ── 未收录 ── */
.empty {
  text-align: center;
  padding: 52rpx 32rpx;
  border-style: dashed;
  border-color: #3A74AA;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #E8F0F8;
  margin-bottom: 14rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #94AECB;
  line-height: 1.7;
  margin-bottom: 28rpx;
}

.empty-btn {
  display: inline-block;
  background: linear-gradient(180deg, #E8C55C, #C9A227);
  color: #1A1400;
  font-size: 26rpx;
  font-weight: 700;
  padding: 18rpx 44rpx;
  border-radius: 10rpx;
}

/* ── 页脚 ── */
.foot-note {
  font-size: 20rpx;
  color: #7189A6;
  line-height: 1.75;
  padding: 24rpx 32rpx 40rpx;
}

/* ── 项目库横幅 ── */
.lib-banner {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx;
  padding: 26rpx 28rpx;
  background: linear-gradient(135deg, rgba(201, 162, 39, 0.16), rgba(201, 162, 39, 0.05));
  border: 1rpx solid rgba(201, 162, 39, 0.45);
  border-left: 6rpx solid #C9A227;
  border-radius: 16rpx;
}

.lib-num {
  font-size: 56rpx;
  font-weight: 800;
  color: #E8C55C;
  line-height: 1;
  margin-right: 24rpx;
}

.lib-mid {
  flex: 1;
  min-width: 0;
}

.lib-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #E8F0F8;
}

.lib-desc {
  font-size: 21rpx;
  color: #94AECB;
  margin-top: 6rpx;
}

.lib-go {
  font-size: 26rpx;
  font-weight: 700;
  color: #E8C55C;
  flex: none;
}

/* ── 键值行 ── */
.kv {
  display: flex;
  align-items: flex-start;
  padding: 6rpx 0;
}

.kv-k {
  width: 96rpx;
  flex: none;
  font-size: 22rpx;
  color: #94AECB;
}

.kv-v {
  flex: 1;
  font-size: 24rpx;
  color: #E8F0F8;
  line-height: 1.65;
}

/* ── 正文段 ── */
.p {
  font-size: 25rpx;
  color: #BED2E6;
  line-height: 1.75;
}

/* ── 特征 / 来源 ── */
.feat {
  font-size: 24rpx;
  color: #BED2E6;
  line-height: 1.9;
}

.src {
  font-size: 21rpx;
  color: #94AECB;
  line-height: 1.8;
}

/* ── 名单卡 ── */
.risk-card {
  border-color: #3A74AA;
}

.rc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.rc-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #E8F0F8;
  flex: 1;
}

.rc-note {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #33628F;
  font-size: 20rpx;
  color: #94AECB;
  line-height: 1.7;
}

/* ── 状态标签 ── */
.st {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  flex: none;
}

.st-boom {
  color: #FFD3D1;
  background: rgba(217, 67, 63, 0.35);
  border: 1rpx solid rgba(217, 67, 63, 0.7);
}

.st-warn {
  color: #FFE0C2;
  background: rgba(224, 123, 57, 0.3);
  border: 1rpx solid rgba(224, 123, 57, 0.65);
}

.st-other {
  color: #BED2E6;
  background: rgba(110, 136, 166, 0.22);
  border: 1rpx solid rgba(110, 136, 166, 0.5);
}

/* ── 案例列表 ── */
.cl {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-top: 1rpx solid #245488;
}

.cl:first-of-type {
  border-top: none;
}

.cl-main {
  flex: 1;
  min-width: 0;
}

.cl-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #E8F0F8;
}

.cl-meta {
  font-size: 21rpx;
  color: #94AECB;
  margin-top: 4rpx;
}

.cl-badge {
  font-size: 19rpx;
  color: #E8C55C;
  border: 1rpx solid rgba(201, 162, 39, 0.4);
  padding: 3rpx 10rpx;
  border-radius: 4rpx;
  flex: none;
}

/* ── 查看更多 ── */
.more-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  padding: 22rpx;
  background: rgba(201, 162, 39, 0.12);
  border: 1rpx solid rgba(201, 162, 39, 0.45);
  border-radius: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #E8C55C;
}

.more-arrow {
  margin-left: 10rpx;
}

/* ── 首页联系方式 ── */
.home-contact {
  margin: 20rpx 24rpx 0;
  padding: 24rpx 26rpx 20rpx;
  background: linear-gradient(135deg, rgba(201, 162, 39, 0.18), rgba(201, 162, 39, 0.04));
  border: 1rpx solid rgba(201, 162, 39, 0.5);
  border-left: 6rpx solid #C9A227;
  border-radius: 14rpx;
}

.hc-label {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #C9A227;
  margin-bottom: 16rpx;
}

.home-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(0, 0, 0, 0.24);
  border: 1rpx solid rgba(201, 162, 39, 0.4);
  border-radius: 10rpx;
  padding: 16rpx 22rpx;
  margin-bottom: 12rpx;
}

.hr-left {
  flex: 1;
  min-width: 0;
}

.hr-k {
  font-size: 19rpx;
  color: #94AECB;
  letter-spacing: 1rpx;
}

.hr-v {
  font-size: 30rpx;
  font-weight: 700;
  color: #E8C55C;
  margin-top: 4rpx;
  line-height: 1.3;
  word-break: break-all;
}

.hr-copy {
  flex: none;
  font-size: 22rpx;
  font-weight: 700;
  color: #1A1400;
  background: linear-gradient(180deg, #E8C55C, #C9A227);
  padding: 8rpx 22rpx;
  border-radius: 8rpx;
  margin-left: 14rpx;
}
